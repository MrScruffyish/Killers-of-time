# Writes BuildInfo.h with the version and the git commit, run at every build
# (only touches the file when something changed, so nothing is rebuilt for nothing).
# Inputs: SOURCE_DIR, OUTPUT, VERSION.
execute_process(COMMAND git describe --always --dirty --abbrev=7
                WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
if(failed OR commit STREQUAL "")
    set(commit "unknown")
endif()
set(content "// Generated by cmake/BuildInfo.cmake - do not edit.\n#pragma once\n#define KOT_VERSION \"${VERSION}\"\n#define KOT_GIT_COMMIT \"${commit}\"\n")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
endif()
